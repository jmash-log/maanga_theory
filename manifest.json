{
  "manifest_version": 3,
  "name": "Manglish Goblin",
  "version": "1.0",
  "description": "A little Goblin that turns Manglish words into emojis.",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_title": "Activate Goblin"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/goblin.png"],
      "matches": ["<all_urls>"]
    }
  ]
}